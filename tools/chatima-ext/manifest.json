{
  "manifest_version": 3,
  "name": "הכלים של גילעד רחמים – תרגום, כרטיסיות, ג׳ימייל ו-PDF בעברית",
  "short_name": "הכלים",
  "version": "3.4.1",
  "description": "כלי עזר אחד לכרום: סידור כרטיסיות, ג׳ימייל, תרגום דפים ו-PDF, תיקון עברית-אנגלית, צילום עמוד וכל הכלים של hakelim.com. בלי שרת.",
  "homepage_url": "https://hakelim.com/kelim/machshev/chatima/tosaf/",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "הכלים של גילעד רחמים",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "alarms",
    "tts",
    "tabGroups",
    "system.memory",
    "favicon",
    "sidePanel",
    "browsingData"
  ],
  "optional_permissions": [
    "tabs",
    "topSites",
    "sessions"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "fix-layout": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "לתקן טקסט שנכתב בשפה הלא נכונה (עברית/אנגלית)"
    },
    "translate-page": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "לתרגם את הדף (לחיצה נוספת מחזירה)"
    },
    "tabs-manager": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "לפתוח את ניהול הכרטיסיות"
    },
    "side-panel": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "לפתוח כלים בחלון צד, ליד הדף"
    },
    "notes": {
      "description": "לפתוח פתקים וטקסטים מוכנים בחלון הצד (אפשר לקבוע מקש ב-chrome://extensions/shortcuts)"
    },
    "open-whatsapp": {
      "description": "לפתוח את ווטסאפ ווב"
    },
    "open-gmail": {
      "description": "לפתוח את ג׳ימייל"
    },
    "open-calendar": {
      "description": "לפתוח את יומן גוגל"
    },
    "open-drive": {
      "description": "לפתוח את גוגל דרייב"
    },
    "open-photos": {
      "description": "לפתוח את גוגל תמונות"
    },
    "open-home": {
      "description": "לפתוח את \"הדף שלי\""
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "gmail.js"
      ],
      "css": [
        "gmail.css"
      ]
    },
    {
      "matches": [
        "https://hakelim.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
